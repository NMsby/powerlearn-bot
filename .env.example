# PowerLearn LMS Bot Configuration
#
# This is a template for the .env file. Copy this file to .env
# and adjust the values according to your needs.

#-------------------------------------------------
# Dashboard Configuration
#-------------------------------------------------
# Dashboard server port
DASHBOARD_PORT=8080

# Enable dashboard server (true/false)
DASHBOARD_ENABLED=true

#-------------------------------------------------
# LMS Credentials (Required)
#-------------------------------------------------
POWERLEARN_EMAIL=your_email@example.com
POWERLEARN_PASSWORD=your_password

#-------------------------------------------------
# LMS URLs
#-------------------------------------------------
# Login page URL
LMS_LOGIN_URL=https://academy.powerlearnprojectafrica.org/login

# Dashboard URL
LMS_DASHBOARD_URL=https://academy.powerlearnprojectafrica.org/

# Activity URLs (comma-separated list)
ACTIVITY_URLS=https://academy.powerlearnprojectafrica.org/dashboard

#-------------------------------------------------
# Browser Configuration
#-------------------------------------------------
# Run in headless mode (true/false)
HEADLESS_MODE=true

# Browser type (chromium, firefox, webkit)
BROWSER_TYPE=firefox

#-------------------------------------------------
# Proxy Configuration
#-------------------------------------------------
# Enable proxy (true/false)
USE_PROXY=false

# Proxy URL (protocol://host:port)
PROXY_URL=http://proxy:port

#-------------------------------------------------
# Session Configuration
#-------------------------------------------------
# Session duration in seconds (default: 900)
SESSION_DURATION=300

# Pause between sessions in seconds (default: 300)
PAUSE_BETWEEN=60

#-------------------------------------------------
# Activity Simulation
#-------------------------------------------------
# Enable activity simulation (true/false)
ACTIVITY_ENABLED=true

# Minimum actions per session
MIN_ACTIONS=3

# Maximum actions per session
MAX_ACTIONS=4

#-------------------------------------------------
# Logging Configuration
#-------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Take screenshots on errors (true/false)
SCREENSHOTS_ON_ERROR=true